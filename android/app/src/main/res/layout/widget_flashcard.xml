<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flashcard_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/launcher_icon"
            android:contentDescription="EKiiYou" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="اختبر نفسك • Flashcard"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flashcard_progress_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_secondary"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="0/10"
            android:textColor="#60A5FA"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Word & Hidden/Revealed Answer -->
    <LinearLayout
        android:id="@+id/flashcard_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/flashcard_english_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Resilient"
            android:textColor="#FFFFFF"
            android:textDirection="ltr"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flashcard_answer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="فكّر في المعنى ثم اضغط إظهار الإجابة"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Bar: either "Show Answer" button OR "Forgot / Remembered" buttons -->
    <TextView
        android:id="@+id/btn_flashcard_reveal"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/widget_btn_primary"
        android:gravity="center"
        android:text="👁 إظهار المعنى"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/flashcard_answer_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_flashcard_forgot"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_danger"
            android:gravity="center"
            android:text="✗ نسيتها"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_flashcard_remembered"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_success"
            android:gravity="center"
            android:text="✓ تذكرتها"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
